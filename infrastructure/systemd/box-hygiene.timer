[Unit]
Description=Run the dashboard EC2 disk-hygiene pass weekly
# NO Requires=<unit>.service here (alpha-engine-config-I9000) — Requires= in a
# timer's [Unit] is a START dependency, so `enable --now <timer>` in an
# installer also starts the service. Binding is by `Unit=`/same basename.

[Timer]
# Sunday 09:20 UTC — after the Saturday weekly pipeline is long done, before
# the Monday preopen chain. Catch up a missed slot if the box was down.
OnCalendar=Sun *-*-* 09:20:00 UTC
Persistent=true
Unit=box-hygiene.service

[Install]
WantedBy=timers.target
