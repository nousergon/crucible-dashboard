[Unit]
Description=Publish cgroup memory-kill delta to CloudWatch (alpha-engine-config-I4486)
Documentation=https://github.com/nousergon/nous-ergon-ops/blob/main/policies/shared-application-host-policy.md
After=network-online.target
Wants=network-online.target

# X-InstallMayStart: this unit is DELIBERATELY started by
# install-cloudwatch-agent-config.sh ("priming the OOM baseline") — the first
# run establishes the counter the delta is measured against, and a failure
# there is cheap to see and fails the install loudly. It calls no paid API and
# publishes one CloudWatch datapoint, so an extra run costs nothing and
# manufactures no failed unit. Declared here rather than allowlisted in the
# test, matching the X-DeadManStaleness= precedent (alpha-engine-config-I9000).
X-InstallMayStart=yes
[Service]
Type=oneshot
ExecStart=/usr/local/bin/emit_oom_metric.sh
User=root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=AWS_REGION=us-east-1
TimeoutStartSec=60

# This publisher must not itself become an unnoticed failure -- that is the
# exact defect it exists to detect elsewhere on this box (I4509).
StandardOutput=journal
StandardError=journal
