[Unit]
Description=Pull latest Alpha Engine code on the micro EC2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
# /var/lib/boot-pull for last-pull-shas, created and owned for User= by systemd —
# the first hourly run (2026-09-13 15:39 UTC) could not mkdir it as ec2-user.
StateDirectory=boot-pull
# alpha-engine-config-I8734: ExecStart MUST point outside the synced
# alpha-engine-dashboard checkout, which boot-pull.sh fast-forwards (and on a
# failed health gate, resets) while it runs. The launcher is installed to
# /usr/local/sbin by install-boot-pull.sh and by boot-pull.sh itself BEFORE
# either copies this unit; boot-pull.sh will not copy this unit while the
# launcher is missing. It snapshots boot-pull.sh from origin/main to a path
# outside the tree and execs the snapshot.
ExecStart=/usr/local/sbin/boot-pull-launcher.sh
TimeoutStartSec=300
RemainAfterExit=no
# Ensure the script sees a sane PATH (includes pip, git, aws)
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/ec2-user/.local/bin
# SSM region for ssm_secrets.load_secrets(), which the boot-pull script's
# flow-doctor heredoc calls before flow_doctor.init(). Secrets
# (FLOW_DOCTOR_GITHUB_TOKEN etc.) come from /alpha-engine/ SSM params.
Environment=AWS_REGION=us-east-1

[Install]
WantedBy=multi-user.target
