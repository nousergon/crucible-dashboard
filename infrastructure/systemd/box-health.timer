[Unit]
Description=Run the dashboard EC2 watchdog every 10 minutes
# NO Requires=<unit>.service here (alpha-engine-config-I9000) — Requires= in a
# timer's [Unit] is a START dependency, so `enable --now <timer>` in an
# installer also starts the service. Binding is by `Unit=`/same basename.

[Timer]
# First run 3 min after boot (let services settle), then every 10 min.
OnBootSec=3min
OnUnitActiveSec=10min
# Catch up one missed run if the box was down at the scheduled slot.
Persistent=true
Unit=box-health.service

[Install]
WantedBy=timers.target
